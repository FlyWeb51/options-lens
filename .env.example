# Copy this file to ".env" and fill in your key.
# Never commit the real .env file.

# Required. Get it at https://massive.com/dashboard/keys
MASSIVE_API_KEY=paste_your_key_here

# Optional: shared password so you can send the link to friends
# without leaving it open to the whole internet. Leave blank to disable.
ACCESS_PASSWORD=

# Requests per minute. Massive's free tier is 5.
# Set to 0 for unlimited (paid plans).
MASSIVE_RATE_LIMIT=5

# How wide a band of strikes to pull, as a fraction of spot price.
STRIKE_WINDOW=0.35

# How many expirations to analyse.
MAX_EXPIRATIONS=6

# Cap on contracts fetched in end-of-day mode (free options tier).
# Each one costs an API call, so at 5 calls/min, 90 contracts is ~18 minutes
# the first time a ticker is looked at. Results are cached for 6 hours after.
MAX_CONTRACTS_EOD=90

# Cache lifetimes in seconds
TTL_CHAIN=600
TTL_QUOTE=300
TTL_REFERENCE=86400
TTL_SLOW=21600

# Fallback if the treasury yield endpoint is unreachable
RISK_FREE_RATE=0.042
