# Copy to ".env" and fill in. Never commit the real .env file.

# ---- Required ----------------------------------------------------------
# https://massive.com/dashboard/keys
MASSIVE_API_KEY=paste_your_key_here

# ---- Recommended -------------------------------------------------------
# Shared password so the public URL is not wide open. Blank disables the gate.
ACCESS_PASSWORD=

# SEC asks for a descriptive User-Agent with contact details. Fundamentals
# come from SEC EDGAR (free), so set this to something identifying you.
SEC_USER_AGENT=options-lens/2.0 (your@email.com)

# ---- Optional extra data sources --------------------------------------
# Each is off by default and the app degrades cleanly without it.
# See the "API Stock" tab in the app for what each one unlocks.

# Campaign finance. Free key: https://api.open.fec.gov/developers/
FEC_API_KEY=

# Analyst consensus estimates (not yet wired up, reserved)
FINNHUB_KEY=
FMP_KEY=

# ---- Performance -------------------------------------------------------
# Massive free tier is 5 requests/minute. Set to 0 if you upgrade.
MASSIVE_RATE_LIMIT=5

# quick | standard | deep. Controls how many contracts a cold ticker fetches.
# quick  ~26 contracts, 2 expiries  -> about 5 minutes on the free tier
# standard ~54 contracts, 4 expiries -> about 11 minutes
# deep   ~96 contracts, 6 expiries  -> about 19 minutes
DEFAULT_SPEED=quick

# Cache lifetimes in seconds
TTL_CHAIN=600
TTL_QUOTE=300
TTL_REFERENCE=86400
TTL_SLOW=21600
TTL_EXTERNAL=3600

RISK_FREE_RATE=0.042
